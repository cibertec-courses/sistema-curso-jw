<%@ page pageEncoding="UTF-8" %>

<%--- Fragmento del Menu -> Va ir en varias paginas --%>

<%
// Detecta en que pagina estamos para resaltar el tab correcto
	String menuUri = request.getRequestURI();
	boolean menuInicio = menuUri.endsWith("/") || menuUri.endsWith("index.jsp");
	boolean menuMant = menuUri.endsWith("CursoServlet") || menuUri.endsWith("DocenteServlet");
%>

<header class="mb-3">
	<nav>
		<ul class="nav nav-tabs">
			<li class="nav-item">
				<a class="nav-link <%= menuInicio ? "active" : "" %>" href="index.jsp"> Principal  </a>
			</li>
			<li class="nav-item dropdown">
				<a class="nav-link dropdown-toggle <%= menuMant ? "active" : "" %>" data-bs-toggle="dropdown" href="#" role="button">Mantenedores</a>
		        <ul class="dropdown-menu">
		          <li><a class="dropdown-item" href="CursoServlet?type=list">Cursos</a></li>
		          <li><a class="dropdown-item" href="DocenteServlet?type=list">Docente</a></li>
				</ul>
			</li>
		    <li class="nav-item">
		      <a class="nav-link disabled" aria-disabled="true">Reportes</a>
		    </li>
		    <li class="nav-item">
		      <a class="nav-link disabled" aria-disabled="true">Soporte</a>
		    </li>
			
		</ul>
	</nav>
</header>